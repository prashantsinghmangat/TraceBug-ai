{
  "manifest_version": 3,
  "name": "TraceBug: Bug Report Recorder & Replay",
  "short_name": "TraceBug",
  "version": "1.12.0",
  "description": "Audit a page or record a bug: accessibility and SEO fixes, replay, console and network in one offline file. Free, no upload.",
  "author": "Prashant Singh Mangat",
  "homepage_url": "https://tracebug.dev",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "offscreen",
    "tabCapture"
  ],
  "minimum_chrome_version": "116",
  "commands": {
    "tb-quick-capture": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Capture a bug on the current tab"
    }
  },
  "optional_host_permissions": [
    "<all_urls>",
    "https://api.github.com/*",
    "https://api.linear.app/*",
    "https://hooks.slack.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TraceBug: capture a bug"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tracebug-sdk-ext.js",
        "tracebug-init.js",
        "player.html",
        "player.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
