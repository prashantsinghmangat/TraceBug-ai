node_modules/
dist/
.next/
# Every env file (.env, .env.local, .env.production, ...) except committed examples.
.env*
!.env*.example
*.log
*.tgz

# Editor / tooling local state — not part of the project
.claude/*
!.claude/skills/
!.claude/settings.json
docs/launch/designs/*/code.html
.cursor/
.vscode/
.idea/

# Generated at build time from dist/bin.mjs (npm run build:cli)
packages/tracebug/bin.mjs

# Generated at build time by `npm run gen:rrweb` (a `prebuild` hook regenerates
# it). Statically imported by src/exporters/html-replay.ts — builds run gen first.
src/exporters/rrweb-runtime.generated.ts

# Local release artifacts (extension zips etc.)
releases/

# Marketing and store images, video, and their sources (see assets/README.md)
assets/

# Demo video: raw recordings and everything generated (see marketing/demo-video/README.md)
marketing/demo-video/clips/
marketing/demo-video/out/

# Playwright e2e output
e2e/bug-reports/
e2e/output/
test-results/
playwright-report/
docs-internal/

# tsc incremental build cache - a build artifact, not source.
*.tsbuildinfo

# axe-core copied in by tracebug-extension/build/build-ext.mjs (Site Audit)
tracebug-extension/vendor/

# Internal: plans, marketing, stats, audits, release sheets. Kept locally, never published
# (the repo is public). CODEMAP.md stays public: it is a code map for contributors.
docs/launch/*
!docs/launch/CODEMAP.md
docs/audit/
docs/audit-quality/
docs/release-sheets/
METRICS.md
